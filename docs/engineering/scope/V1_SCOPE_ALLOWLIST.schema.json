{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yunmom.invalid/schemas/v1-scope-allowlist.schema.json",
  "title": "YunMom V1 Scope Allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "scope_version",
    "jurisdiction",
    "audience",
    "release_status",
    "platform_contract",
    "updated_at",
    "scope_statuses",
    "delivery_states",
    "registers",
    "release_binding"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scope_id": {"const": "yunmom-cn-public-store-v1"},
    "scope_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "jurisdiction": {"const": "CN_MAINLAND"},
    "audience": {"const": "ADULT_18_PLUS_PREGNANCY"},
    "release_status": {"enum": ["RELEASE_NOT_APPROVED", "RELEASE_APPROVED"]},
    "platform_contract": {"const": "ANDROID_FIRST_IOS_ANDROID_SEMANTIC_PARITY"},
    "updated_at": {"type": "string", "format": "date-time"},
    "scope_statuses": {
      "const": ["required_enabled", "required_present_disabled", "future_explicitly_excluded"]
    },
    "delivery_states": {
      "const": ["planned", "scaffolded_disabled", "implemented", "verified", "excluded"]
    },
    "registers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/register"}
    },
    "release_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_tag",
        "build_hash",
        "feature_flag_manifest",
        "schema_registry_version",
        "provider_allowlist_version",
        "rule_pack_versions",
        "skill_manifest_version",
        "required_signatures"
      ],
      "properties": {
        "source_tag": {"type": ["string", "null"]},
        "build_hash": {"type": ["string", "null"]},
        "feature_flag_manifest": {"type": ["string", "null"]},
        "schema_registry_version": {"type": "string"},
        "provider_allowlist_version": {"type": "string"},
        "rule_pack_versions": {"type": "array", "items": {"type": "string"}},
        "skill_manifest_version": {"type": "string"},
        "required_signatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["PO", "TECH", "QA", "MD", "LEGAL", "SEC", "ETHICS"]}
        }
      }
    }
  },
  "$defs": {
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "default_owner_roles", "items"],
      "properties": {
        "id": {
          "enum": [
            "R1_PRODUCT_AND_SKILLS",
            "R2_CLINICAL_DATA_AND_EGRESS",
            "R3_SURFACES_PORTABILITY_AND_PLATFORMS",
            "R4_EXCLUSIONS_AND_CHANGE_TRIGGERS"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "default_owner_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["PO", "TECH", "QA", "MD", "LEGAL", "SEC", "ETHICS"]}
        },
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "phase", "name", "scope_status", "delivery_state", "contract_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
        "kind": {
          "enum": [
            "feature",
            "skill",
            "rule_pack",
            "provider_model",
            "field_type",
            "widget",
            "export_archive",
            "platform",
            "exclusion"
          ]
        },
        "phase": {"enum": ["P1", "P2", "P3", "P4", "P5", "P6", "CROSS", "FUTURE"]},
        "name": {"type": "string", "minLength": 1},
        "scope_status": {
          "enum": ["required_enabled", "required_present_disabled", "future_explicitly_excluded"]
        },
        "delivery_state": {
          "enum": ["planned", "scaffolded_disabled", "implemented", "verified", "excluded"]
        },
        "contract_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9]+-[0-9]{3}$"}
        },
        "gates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
