{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yunmom.local/schemas/engineering-plan-v1.json",
  "title": "YunMom Engineering Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "program_version",
    "updated_at",
    "release_status",
    "current_stage",
    "authority",
    "visual_input",
    "path_ownership",
    "stages",
    "evidence",
    "work_items"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "const": "yunmom-engineering-program" },
    "program_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated_at": { "type": "string", "format": "date-time" },
    "release_status": { "enum": ["RELEASE_NOT_APPROVED", "RELEASE_APPROVED"] },
    "current_stage": { "type": "string", "pattern": "^M([0-9]|1[01])$" },
    "authority": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/fileBinding" }
    },
    "visual_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "observed_revision", "observed_gate", "observed_release_status", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "observed_revision": { "type": "integer", "minimum": 0 },
        "observed_gate": { "type": "string" },
        "observed_release_status": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "path_ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream", "paths"],
        "properties": {
          "stream": { "enum": ["engineering", "visual", "shared_single_writer"] },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/stage" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workItem" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "depends_on", "exit_criteria"],
      "properties": {
        "id": { "type": "string", "pattern": "^M([0-9]|1[01])$" },
        "title": { "type": "string", "minLength": 1 },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "exit_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "path", "sha256", "source_commit", "build_hash", "captured_at",
        "result", "data_class", "reviewer_roles"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^EV-[A-Z0-9-]+$" },
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "build_hash": { "type": ["string", "null"] },
        "captured_at": { "type": "string", "format": "date-time" },
        "result": { "enum": ["pass", "fail", "blocked"] },
        "data_class": { "enum": ["no_health_content", "synthetic", "irreversibly_deidentified"] },
        "reviewer_roles": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "stage", "title", "status", "scope_class", "depends_on", "contract_refs",
        "eng_attachment_refs", "owner_roles", "path_claims", "deliverables", "acceptance",
        "evidence_refs", "external_gates"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^M([0-9]|1[01])-WP[0-9]{2}$" },
        "stage": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["planned", "ready", "in_progress", "verification_pending", "done", "blocked", "deferred", "superseded"]
        },
        "scope_class": { "enum": ["required", "future_explicitly_excluded"] },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "contract_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "eng_attachment_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "owner_roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "path_claims": { "type": "array", "items": { "type": "string" } },
        "deliverables": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "external_gates": { "type": "array", "items": { "type": "string" } },
        "blocker": { "type": "object" },
        "successor": { "type": "string" },
        "change_ref": { "type": "string" }
      }
    }
  }
}
